# Copie para .env (que NAO e versionado) e troque TODOS os valores marcados com "troque".
# Nunca coloque segredos reais neste arquivo de exemplo.

# --- Banco ---
DB_NAME=appdb
# Senha do administrador do SQL Server (sa). Exige senha forte: 8+ caracteres com maiuscula, minuscula, numero e simbolo.
DB_PASSWORD=TroqueEstaSenha#2024
# Usuario de RUNTIME da aplicacao (sem DDL). Criado automaticamente pelo apply.sh.
APP_DB_USER=app_runtime
# 12+ caracteres entre letras, numeros e @#%^*_+=.!-   (troque)
APP_DB_PASSWORD=TroqueSenhaDaApp2024
# true so no SQL Server do Docker (certificado autoassinado). Em producao: false, com certificado valido.
DB_TRUST_SERVER_CERT=true

# --- Segredos da aplicacao ---
# Gere com: openssl rand -base64 48   (troque)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Chave AES-256 que protege os segredos do MFA no banco. Gere com: openssl rand -base64 32   (troque)
# ATENCAO: perder/trocar esta chave invalida o MFA ja configurado dos usuarios.
MFA_ENCRYPTION_KEY=troque-gere-com-openssl-rand-base64-32

# --- Comportamento ---
# URL publica do frontend (usada nos links dos e-mails).
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# false = so quem ja tem conta entra (produtos privados). true = qualquer pessoa pode criar conta.
REGISTRATION_ENABLED=true
# true exige HTTPS (use true em producao/HTTPS). Em http://localhost o Chrome/Firefox aceitam, mas deixe false no Docker local.
COOKIE_SECURE=false
SWAGGER_ENABLED=true
